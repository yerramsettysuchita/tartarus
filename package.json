{
  "name": "tartarus",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Red-Team & SecOps agent built on the TrueForge agent harness.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "tartarus": "./dist/agent/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mcp": "tsx src/mcp/server.ts",
    "register": "tsx src/agent/register.ts",
    "doctor": "tsx src/agent/doctor.ts",
    "hunt": "tsx src/agent/run.ts",
    "hunt:ui": "tsx src/agent/run.ts --ui",
    "sentinel": "tsx src/server/sentinel.ts",
    "tunnel": "node scripts/start-tunnel.mjs",
    "webhook:register": "tsx scripts/register-webhook.ts",
    "start:godmode": "concurrently -k -n mcp,sentinel,tunnel -c green,magenta,cyan \"npm:mcp\" \"npm:sentinel\" \"npm:tunnel\"",
    "heal": "tsx src/agent/heal.ts",
    "demo": "tsx src/agent/demo.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -n mcp,agent -c green,magenta \"npm:mcp\" \"npm:hunt\"",
    "mcp:debug": "cross-env TARTARUS_DEBUG=true npm run mcp",
    "hunt:debug": "tsx src/agent/run.ts --debug",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "serve": "node dist/server/serve.js"
  },
  "dependencies": {
    "@daytona/sdk": "^0.207.0",
    "@inquirer/prompts": "^8.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
