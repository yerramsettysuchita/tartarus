# ─────────────────────────────────────────────────────────────────────────────
# Tartarus — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── TrueForge harness (the runtime that drives the agent loop) ───────────────
# Local mode:  npx @truefoundry/trueforge@latest   → http://localhost:8790
TRUEFORGE_BASE_URL=http://localhost:8790
# Only needed when TrueForge has OIDC login enabled (hosted mode).
TRUEFORGE_TOKEN=

# ── LLM: Claude via Anthropic ────────────────────────────────────────────────
# Configured inside TrueForge (Settings → Models) but kept here for reference.
ANTHROPIC_API_KEY=sk-ant-...
# TrueForge model id is "<provider>/<model>". Hackathon brief asks for Sonnet.
TARTARUS_MODEL=anthropic/claude-sonnet-4-6

# ── Tartarus MCP server (the tools this repo exposes to the agent) ───────────
# The harness reaches these tools over MCP. Must be reachable from TrueForge.
TARTARUS_MCP_PORT=8123
TARTARUS_MCP_URL=http://localhost:8123/mcp
# Shared secret sent as a header so only TrueForge can call our tools.
TARTARUS_MCP_TOKEN=change-me-to-a-long-random-string

# ── GitHub (repo scanning + PR creation) ─────────────────────────────────────
# Fine-grained PAT with: Contents (read/write), Pull requests (read/write).
GITHUB_TOKEN=github_pat_...
# Default target repo, "owner/name". Can be overridden per-tool-call.
TARGET_REPO=octo-org/vulnerable-app
# Sentinel Mode: shared secret for GitHub webhook signature verification.
# Set the SAME value in the repo's webhook settings. Leave blank only for local dev.
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# ── Command Center / Sentinel ────────────────────────────────────────────────
# Web dashboard + webhook server port (npm run hunt:ui / npm run sentinel).
TARTARUS_UI_PORT=8799
# Optional: ngrok auth token for `npm run tunnel` (else it falls back to localtunnel).
NGROK_AUTHTOKEN=

# ── Daytona sandbox (TrueForge's "TrueForge Sandbox" execution provider) ─────
# Where exploits are DETONATED in isolation. Key needs Snapshots:write.
DAYTONA_API_KEY=dtn_...
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
